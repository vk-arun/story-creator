# MongoDB Connection URI (Atlas or Local)
# If omitted, server will automatically use an in-memory fallback store with pre-seeded stories
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/storycreator?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_story_creator_jwt_key_change_me_in_production

# Default Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server Port
PORT=5000
